{
  "rewrites": [
    {
      "source": "/bio",
      "destination": "/bio.html"
    },
    {
      "source": "/agenda",
      "destination": "/api/lead-capture?atalho=agenda"
    },
    {
      "source": "/agenda/:c",
      "destination": "/api/lead-capture?atalho=agenda&c=:c"
    },
    {
      "source": "/reuniao",
      "destination": "/api/lead-capture?atalho=reuniao"
    },
    {
      "source": "/reuniao/:c",
      "destination": "/api/lead-capture?atalho=reuniao&c=:c"
    },
    {
      "source": "/m/:id.:ext",
      "destination": "/api/media?id=:id"
    },
    {
      "source": "/media/:file",
      "destination": "/api/media-upload?f=:file"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ],
  "functions": {
    "api/db.js": {
      "maxDuration": 60
    },
    "api/s2-creative.js": {
      "maxDuration": 60
    },
    "api/financeiro.js": {
      "maxDuration": 60
    },
    "api/email-intel.js": {
      "maxDuration": 60
    },
    "api/media-upload.js": {
      "maxDuration": 30
    },
    "api/faturamento.js": {
      "maxDuration": 60
    },
    "api/rh.js": {
      "maxDuration": 60
    },
    "api/dev-pipeline.js": {
      "maxDuration": 60
    },
    "api/cnab.js": {
      "maxDuration": 30
    },
    "api/pmo.js": {
      "maxDuration": 60
    },
    "api/media.js": {
      "maxDuration": 60,
      "includeFiles": "api/fonts/**"
    },
    "api/crm.js": {
      "maxDuration": 60
    },
    "api/metricool.js": {
      "maxDuration": 60
    },
    "api/termo-excel.js": {
      "maxDuration": 30,
      "includeFiles": "api/modelos/**"
    },
    "api/prospeccao.js": {
      "maxDuration": 60
    },
    "api/prospect-scan.js": {
      "maxDuration": 60
    },
    "api/s1-strategy.js": {
      "maxDuration": 180
    },
    "api/business-plan.js": {
      "maxDuration": 300
    },
    "api/rfp-monitor.js": {
      "maxDuration": 90
    },
    "api/qa.js": {
      "maxDuration": 120,
      "includeFiles": "{api/**,lib/**,public/*.html,public/*.js}"
    },
    "api/image-gen.js": {
      "maxDuration": 60
    },
    "api/vendas.js": {
      "maxDuration": 120
    },
    "api/campanha-disparo.js": {
      "maxDuration": 120
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/agente-ideias.js": {
      "maxDuration": 180,
      "includeFiles": "public/index.html"
    },
    "api/analytics.js": {
      "maxDuration": 60
    },
    "api/claude.js": {
      "maxDuration": 60
    },
    "api/decisor-map.js": {
      "maxDuration": 60
    },
    "api/s1-data.js": {
      "maxDuration": 60
    },
    "api/s1-intel.js": {
      "maxDuration": 60
    },
    "api/meeting-schedule.js": {
      "maxDuration": 60
    },
    "api/outreach-batch.js": {
      "maxDuration": 60
    },
    "api/vendas-outbound.js": {
      "maxDuration": 60
    },
    "api/wa-batch-generate.js": {
      "maxDuration": 60
    },
    "api/wa-response.js": {
      "maxDuration": 60
    },
    "api/followup-cron.js": {
      "maxDuration": 60
    },
    "api/portal-cadastro.js": {
      "maxDuration": 60
    },
    "api/health.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/rfp-monitor",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/followup-cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/briefing-cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/financeiro?action=marcos_processar_alertas",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/health?full=1",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/financeiro?action=relatorio_pagamentos",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/financeiro?cron=termos_obrigatorios",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/financeiro?cron=pendencias_faturamento",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/financeiro?cron=conciliar_notas",
      "schedule": "0 11,15,20 * * *"
    },
    {
      "path": "/api/metricool?cron=fila",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/campanha-disparo?cron=1",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/agente-ideias?cron=1",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/financeiro?cron=aquecer_cache",
      "schedule": "*/10 9-23 * * *"
    },
    {
      "path": "/api/vendas?cron=painel",
      "schedule": "*/4 9-23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ]
}
