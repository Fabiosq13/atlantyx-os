{
  "rewrites": [
    {
      "source": "/media/:file",
      "destination": "/api/media-upload?f=:file"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ],
  "functions": {
    "api/s2-creative.js": {
      "maxDuration": 60
    },
    "api/financeiro.js": {
      "maxDuration": 60
    },
    "api/email-intel.js": {
      "maxDuration": 60
    },
    "api/media-upload.js": {
      "maxDuration": 30
    },
    "api/faturamento.js": {
      "maxDuration": 60
    },
    "api/rh.js": {
      "maxDuration": 60
    },
    "api/dev-pipeline.js": {
      "maxDuration": 60
    },
    "api/cnab.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/rfp-monitor",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/followup-cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/briefing-cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/financeiro?action=marcos_processar_alertas",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/health?full=1",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/financeiro?action=relatorio_pagamentos",
      "schedule": "0 11 * * *"
    }
  ]
}