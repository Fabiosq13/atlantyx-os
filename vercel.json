{
  "rewrites": [
    {
      "source": "/bio",
      "destination": "/bio.html"
    },
    {
      "source": "/agenda",
      "destination": "/api/lead-capture?atalho=agenda"
    },
    {
      "source": "/agenda/:c",
      "destination": "/api/lead-capture?atalho=agenda&c=:c"
    },
    {
      "source": "/reuniao",
      "destination": "/api/lead-capture?atalho=reuniao"
    },
    {
      "source": "/reuniao/:c",
      "destination": "/api/lead-capture?atalho=reuniao&c=:c"
    },
    {
      "source": "/m/:id.:ext",
      "destination": "/api/media?id=:id"
    },
    {
      "source": "/media/:file",
      "destination": "/api/media-upload?f=:file"
    },
    {
      "source": "/qa/:t",
      "destination": "/api/fabrica?action=painel_cliente&t=:t"
    },
    {
      "source": "/tv/:t",
      "destination": "/api/tv?t=:t"
    },
    {
      "source": "/atv-youtube-retorno",
      "destination": "/api/atv?yt_cb=1"
    },
    {
      "source": "/atv/:t",
      "destination": "/api/atv?t=:t"
    },
    {
      "source": "/atvl/:t/:w",
      "destination": "/api/atv?t=:t&layout=:w"
    },
    {
      "source": "/ao-vivo/:s",
      "destination": "/api/atv?sala=:s"
    },
    {
      "source": "/convidado/:c",
      "destination": "/api/atv?convidado=:c"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ],
  "functions": {
    "api/db.js": {
      "maxDuration": 60
    },
    "api/s2-creative.js": {
      "maxDuration": 60
    },
    "api/financeiro.js": {
      "maxDuration": 60
    },
    "api/email-intel.js": {
      "maxDuration": 60
    },
    "api/media-upload.js": {
      "maxDuration": 30
    },
    "api/faturamento.js": {
      "maxDuration": 60
    },
    "api/rh.js": {
      "maxDuration": 60
    },
    "api/dev-pipeline.js": {
      "maxDuration": 60
    },
    "api/cnab.js": {
      "maxDuration": 30
    },
    "api/pmo.js": {
      "maxDuration": 60
    },
    "api/media.js": {
      "maxDuration": 60,
      "includeFiles": "api/fonts/**"
    },
    "api/crm.js": {
      "maxDuration": 60
    },
    "api/metricool.js": {
      "maxDuration": 60
    },
    "api/briefing-cron.js": {
      "maxDuration": 60
    },
    "api/termo-excel.js": {
      "maxDuration": 30,
      "includeFiles": "api/modelos/**"
    },
    "api/prospeccao.js": {
      "maxDuration": 60
    },
    "api/prospect-scan.js": {
      "maxDuration": 60
    },
    "api/s1-strategy.js": {
      "maxDuration": 180
    },
    "api/business-plan.js": {
      "maxDuration": 300
    },
    "api/rfp-monitor.js": {
      "maxDuration": 90
    },
    "api/qa.js": {
      "maxDuration": 120,
      "includeFiles": "{api/**,lib/**,public/*.html,public/*.js}"
    },
    "api/image-gen.js": {
      "maxDuration": 60
    },
    "api/vendas.js": {
      "maxDuration": 120
    },
    "api/campanha-disparo.js": {
      "maxDuration": 120
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/agente-ideias.js": {
      "maxDuration": 180,
      "includeFiles": "{public/index.html,partitura/escopos.json}"
    },
    "api/analytics.js": {
      "maxDuration": 60
    },
    "api/claude.js": {
      "maxDuration": 60
    },
    "api/decisor-map.js": {
      "maxDuration": 60
    },
    "api/s1-data.js": {
      "maxDuration": 60
    },
    "api/s1-intel.js": {
      "maxDuration": 180
    },
    "api/meeting-schedule.js": {
      "maxDuration": 60
    },
    "api/outreach-batch.js": {
      "maxDuration": 60
    },
    "api/vendas-outbound.js": {
      "maxDuration": 60
    },
    "api/wa-batch-generate.js": {
      "maxDuration": 60
    },
    "api/wa-response.js": {
      "maxDuration": 60
    },
    "api/followup-cron.js": {
      "maxDuration": 60
    },
    "api/portal-cadastro.js": {
      "maxDuration": 60
    },
    "api/health.js": {
      "maxDuration": 60
    },
    "api/qa-externo.js": {
      "maxDuration": 300
    },
    "api/fabrica.js": {
      "maxDuration": 300,
      "includeFiles": "partitura/escopos.json"
    },
    "api/tendencias.js": {
      "maxDuration": 300
    },
    "api/reunioes.js": {
      "maxDuration": 180
    },
    "api/tv.js": {
      "maxDuration": 120
    },
    "api/estrategia.js": {
      "maxDuration": 300
    },
    "api/atv.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/rfp-monitor",
      "schedule": "0 10 * * 1-5"
    },
    {
      "path": "/api/rfp-monitor?acao=petronect",
      "schedule": "30 10 * * 1-5"
    },
    {
      "path": "/api/followup-cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/briefing-cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/financeiro?action=marcos_processar_alertas",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/health?full=1",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/financeiro?action=relatorio_pagamentos",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/financeiro?cron=termos_obrigatorios",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/financeiro?cron=pendencias_faturamento",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/financeiro?cron=conciliar_notas",
      "schedule": "0 11,15,20 * * *"
    },
    {
      "path": "/api/metricool?cron=fila",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/campanha-disparo?cron=1",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/agente-ideias?cron=1",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/reunioes?cron=1",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/atv?cron=1",
      "schedule": "20 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ]
}
